<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PersianCalendar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Compatibility alias for projects that referenced the original misspelled style. -->
    <style name="Theme.PersionCalendar" parent="@style/Theme.PersianCalendar" />
</resources>
